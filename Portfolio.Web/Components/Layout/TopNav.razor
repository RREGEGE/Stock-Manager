@inherits LiveComponentBase

@* 상단 바: 메뉴, 장 상태·마지막 시세 갱신 시각. 폭 640px 미만에서는 총 평가금액·손익을 담은 헤더로 바뀐다 (설계서 9.3, 9.4) *@
<header class="topbar">
    <div class="topbar-inner">
        <div class="brand">@T["포트폴리오"]</div>
        @if (Model is { } current)
        {
            @* 계좌 전환 (F-11): 고르면 모든 화면이 그 계좌 기준으로 바뀐다 *@
            <select class="account-select" aria-label="@T["계좌"]" @onchange="SwitchAccount">
                @foreach (var a in current.State.Accounts)
                {
                    <option value="@a.Id" selected="@(a.Id == current.State.Account.Id)">@a.Name</option>
                }
            </select>
        }
        <nav aria-label="@T["주 메뉴"]" class="topnav">
            <NavLink href="" Match="NavLinkMatch.All">@T["대시보드"]</NavLink>
            <NavLink href="holdings">@T["보유 종목"]</NavLink>
            <NavLink href="rebalance">@T["리밸런싱"]</NavLink>
            <NavLink href="groups">@T["그룹 관리"]</NavLink>
        </nav>
        <div class="market">
            <span class="market-dot @(Model?.State.MarketOpen == true ? "live" : "")"></span>
            <span class="market-text">@(Model?.MarketText(T))</span>
            <span class="market-text-short">@(Model?.MarketTextShort(T))</span>
            <NavLink href="settings" class="settings-link">@T["설정"]</NavLink>
        </div>
    </div>
    @if (Model is { } m)
    {
        var s = m.State.Summary;
        <div class="mobile-total">
            <div class="mobile-total-label">@T["총 평가금액"]</div>
            <div class="mobile-total-amount">@(T.IsEnglish ? "₩" : "")@DisplayFormat.Number(s.TotalAmount)<span>@(T.IsEnglish ? "" : "원")</span></div>
            @if (s.PricedCount == 0)
            {
                @* 현재가가 없으면 손익을 0이나 손실로 보여 주지 않는다 *@
                <div class="mobile-total-pl">@T[m.Rows.Count == 0 ? "보유 종목을 추가하세요" : "현재가를 받으면 손익이 계산됩니다"]</div>
            }
            else
            {
                <div class="mobile-total-pl @(s.ProfitLoss > 0 ? "up" : s.ProfitLoss < 0 ? "down" : "")">
                    @T.SignedWon(s.ProfitLoss) (@DisplayFormat.SignedPercent2(s.ReturnRate))
                </div>
            }
        </div>
    }
</header>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    // 고른 계좌를 쿠키에 적어야 하므로 화면 안 이동이 아니라 페이지를 새로 불러온다
    private void SwitchAccount(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int id) || id == Account.Id) return;
        Navigation.NavigateTo(CurrentAccount.SelectUrl(id, "/" + Navigation.ToBaseRelativePath(Navigation.Uri)), forceLoad: true);
    }
}
