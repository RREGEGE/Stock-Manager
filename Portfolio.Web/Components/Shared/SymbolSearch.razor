@inject PortfolioService Portfolio

@* SymbolMaster 검색 + 결과 목록, 보유 중 표시 (설계서 5.4, 9.5) *@
<div class="field">
    <label for="search">@T["종목 검색"]</label>
    @* 입력하는 동안에는 서버가 입력창 내용을 다시 써 넣지 않는다.
       한글은 조합 중인 글자가 있어서, 칠 때마다 값을 되돌려 쓰면 글자가 두 번 입력된다. *@
    <input @key="_inputVersion" id="search" type="search" class="input search-input" autocomplete="off"
           placeholder="@T["종목명 또는 종목코드"]" value="@_inputValue" @oninput="OnInput" />
    @if (_results.Count > 0)
    {
        <ul aria-label="@T["검색 결과"]" class="results">
            @foreach (var s in _results)
            {
                var symbol = s;
                bool held = HeldCodes.Contains(symbol.SymbolCode);
                <li>
                    <button type="button" class="result @(SelectedCode == symbol.SymbolCode ? "selected" : "")"
                            @onclick="() => Select(symbol)">
                        <span class="result-name">@symbol.SymbolName <span class="result-code">@symbol.SymbolCode</span></span>
                        <span class="result-state">@T[held ? HeldLabel : NewLabel]</span>
                    </button>
                </li>
            }
        </ul>
    }
    else if (_searched)
    {
        <p class="no-result">@T["검색 결과가 없습니다."]</p>
    }
</div>

@code {
    [Parameter] public IReadOnlySet<string> HeldCodes { get; set; } = new HashSet<string>();
    [Parameter] public string? SelectedCode { get; set; }
    [Parameter] public EventCallback<SymbolInfo> OnSelected { get; set; }
    // 결과 오른쪽의 표시. 종목 추가 화면은 '보유 중 · 수정 / 신규', 종목 정보 화면은 '보유 중 / (없음)'
    [Parameter] public string HeldLabel { get; set; } = "보유 중 · 수정";
    [Parameter] public string NewLabel { get; set; } = "신규";

    private string _query = "";          // 검색에 쓰는 현재 입력값
    private string _inputValue = "";     // 서버가 입력창에 써 넣은 값 (수정 버튼·초기화 때만 바뀜)
    private int _inputVersion;           // 바꾸면 입력창을 새로 그려 _inputValue를 반영한다
    private bool _searched;
    private IReadOnlyList<SymbolInfo> _results = [];

    // 표에서 '수정'을 눌렀을 때 검색창에 종목명을 채운다
    public async Task SetQueryAsync(string query)
    {
        _query = query;
        _inputValue = query;
        _inputVersion++;
        await SearchAsync();
        StateHasChanged();
    }

    public void Clear()
    {
        _query = "";
        _inputValue = "";
        _inputVersion++;
        _results = [];
        _searched = false;
        StateHasChanged();
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        string query = _query;
        var results = await Portfolio.SearchSymbolsAsync(query);
        if (query != _query) return;   // 더 늦게 입력한 검색어가 있으면 버린다
        _results = results;
        _searched = query.Trim().Length > 0;
    }

    private Task Select(SymbolInfo symbol) => OnSelected.InvokeAsync(symbol);
}
