@inject CurrentAccount Account
@inject ThemeState ThemeState

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // 이 브라우저가 마지막으로 고른 계좌 (쿠키에서 읽어 App이 넘겨준다, F-11)
    [Parameter] public int AccountId { get; set; }

    // 이 브라우저가 고른 언어 (F-12)
    [Parameter] public string? Language { get; set; }

    // 이 브라우저가 고른 화면 모드 (F-13)
    [Parameter] public string? Theme { get; set; }

    protected override void OnInitialized()
    {
        if (AccountId > 0) Account.Id = AccountId;
        T.Language = Loc.Normalize(Language);
        ThemeState.Mode = Services.ThemeState.Normalize(Theme);
    }
}
