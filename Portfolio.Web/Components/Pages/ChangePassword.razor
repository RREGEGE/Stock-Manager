@page "/account/password"
@layout LoginLayout
@attribute [ExcludeFromInteractiveRouting]
@using Portfolio.Web.Auth
@inject AccountService Accounts
@inject LoginThrottle Throttle

<PageTitle>@T["비밀번호 변경"]</PageTitle>

@* 로그인한 상태에서만 열린다. 바꾼 뒤 이 기기의 쿠키를 새로 발급해야 하므로 서버 렌더링(폼 전송)으로 동작한다. *@
<main class="auth-page">
    <section class="card auth-card" aria-labelledby="h-password">
        <h1 id="h-password" class="auth-title">@T["비밀번호 변경"]</h1>

        @if (_done)
        {
            <p class="auth-sub">@T["비밀번호를 바꿨습니다. 이 기기는 로그인 상태가 유지되고, 다른 기기는 새 비밀번호로 다시 로그인해야 합니다."]</p>
            <a href="settings" class="btn btn-primary auth-button">@T["설정으로 돌아가기"]</a>
        }
        else
        {
            <form method="post" @formname="change-password" @onsubmit="SubmitAsync" class="auth-form">
                <AntiforgeryToken />
                <div class="field">
                    <label for="current">@T["현재 비밀번호"]</label>
                    <input id="current" name="CurrentPassword" type="password" class="input" autocomplete="current-password" autofocus required />
                </div>
                <div class="field">
                    <label for="new">@T.F("새 비밀번호 ({0}자 이상)", AuthOptions.MinPasswordLength)</label>
                    <input id="new" name="NewPassword" type="password" class="input" autocomplete="new-password"
                           minlength="@AuthOptions.MinPasswordLength" required />
                </div>
                <div class="field">
                    <label for="confirm">@T["새 비밀번호 확인"]</label>
                    <input id="confirm" name="ConfirmPassword" type="password" class="input" autocomplete="new-password" required />
                </div>
                @if (_message is not null)
                {
                    <p class="field-error" role="alert">@T[_message]</p>
                }
                <button type="submit" class="btn btn-primary auth-button">@T["비밀번호 변경"]</button>
                <a href="settings" class="btn auth-button">@T["취소"]</a>
            </form>
        }
    </section>
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "change-password")] private string? CurrentPassword { get; set; }
    [SupplyParameterFromForm(FormName = "change-password")] private string? NewPassword { get; set; }
    [SupplyParameterFromForm(FormName = "change-password")] private string? ConfirmPassword { get; set; }

    private string? _message;
    private bool _done;

    private async Task SubmitAsync()
    {
        // 현재 비밀번호 추측도 로그인과 같은 횟수 제한을 받는다
        if (Throttle.LockRemaining is { } remaining)
        {
            _message = LoginThrottle.Message(remaining, T);
            return;
        }
        if (NewPassword != ConfirmPassword)
        {
            _message = "새 비밀번호와 확인이 서로 다릅니다.";
            return;
        }

        try
        {
            if (!await Accounts.ChangePasswordAsync(CurrentPassword, NewPassword))
            {
                Throttle.RecordFailure();
                _message = "현재 비밀번호가 맞지 않습니다.";
                return;
            }
        }
        catch (ArgumentException ex)
        {
            _message = ex.Message;
            return;
        }

        Throttle.RecordSuccess();
        // 비밀번호가 바뀌면 기존 쿠키는 모두 무효가 되므로, 이 기기에는 새 쿠키를 발급한다
        await AccountSignIn.SignInAsync(HttpContext, Accounts);
        _done = true;
    }
}
