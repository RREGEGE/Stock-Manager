@page "/rebalance"
@inherits LiveComponentBase

<PageTitle>추가매수 계산</PageTitle>

<main class="page-main">
    <div class="page-head">
        <div>
            <h1>추가매수 계산</h1>
            <p>매도 없이 매수만으로 목표 비중에 가깝게 배분합니다. @(PricedAtText) 수수료·세금은 제외합니다.</p>
        </div>
    </div>

    @if (Model is { } m && _plan is { } plan)
    {
        @if (!plan.TargetsValid)
        {
            <div class="notice notice-warn" role="alert">
                <span>그룹 목표 비중 합계가 100%가 아니어서 계산할 수 없습니다.</span>
                <a href="groups">그룹 관리에서 조정하기</a>
            </div>
        }
        @if (plan.HasUnclassified)
        {
            <div class="notice notice-warn" role="status">
                <span>미분류 종목이 있습니다. 미분류는 목표 0%로 계산되어 매수 배정을 받지 않습니다.</span>
                <a href="holdings">그룹 지정하기</a>
            </div>
        }

        <section aria-label="투입 금액" class="card amount-card">
            <div class="field">
                <label for="amount">투입 금액</label>
                <div class="amount-input">
                    <MoneyInput Id="amount" Class="amount" Value="_amount" ValueChanged="SetAmount" />
                    <span>원</span>
                </div>
            </div>
            <div class="quick">
                <button type="button" class="btn btn-sm" @onclick="() => SetAmount(_amount + 1_000_000m)">+100만</button>
                <button type="button" class="btn btn-sm" @onclick="() => SetAmount(_amount + 5_000_000m)">+500만</button>
                <button type="button" class="btn btn-sm" @onclick="() => SetAmount(_amount + 10_000_000m)">+1,000만</button>
                <button type="button" class="btn btn-ghost" @onclick="() => SetAmount(0m)">지우기</button>
            </div>
            <div class="totals">
                <div>
                    <div class="total-label">실제 매수 합계</div>
                    <div class="total-value" id="spent">@DisplayFormat.Won(plan.Spent)</div>
                </div>
                <div>
                    <div class="total-label">남는 금액</div>
                    <div class="total-value" id="leftover">@DisplayFormat.Won(plan.Leftover)</div>
                </div>
            </div>
        </section>

        <section aria-labelledby="h-bars" class="card">
            <div class="bars-head">
                <h2 id="h-bars" class="card-title">그룹 비중 변화</h2>
                <div class="bars-legend">
                    @foreach (var g in plan.Groups)
                    {
                        <span class="group-tag"><span class="swatch" style="background: @ColorOf(m, g)"></span>@g.Name</span>
                    }
                </div>
            </div>
            <div class="bars">
                <StackedBar Label="현재" Segments="Segments(m, plan, g => g.CurrentWeight)" />
                <StackedBar Label="매수 후" Bold="true" Segments="Segments(m, plan, g => g.WeightAfter)" />
                <StackedBar Label="목표" Segments="Segments(m, plan, g => g.TargetWeight)" />
            </div>
        </section>

        <div class="split">
            <section aria-labelledby="h-groups" class="card group-card">
                <h2 id="h-groups" class="card-title table-title">그룹별 매수금액</h2>
                <div class="table-scroll">
                    <table class="table" style="min-width: 480px">
                        <thead>
                            <tr>
                                <th scope="col">그룹</th>
                                <th scope="col" class="num">현재</th>
                                <th scope="col" class="num">목표</th>
                                <th scope="col" class="num">매수금액</th>
                                <th scope="col" class="num">매수 후</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in plan.Groups)
                            {
                                <tr>
                                    <td>
                                        <span class="group-name"><span class="swatch" style="background: @ColorOf(m, g)"></span>@g.Name</span>
                                        @if (g.HasNoBuyableHoldings)
                                        {
                                            <span class="badge badge-over">종목 없음</span>
                                        }
                                    </td>
                                    <td class="num">@DisplayFormat.Percent1(g.CurrentWeight)</td>
                                    <td class="num muted">@DisplayFormat.Percent1(g.TargetWeight)</td>
                                    <td class="num buy">@DisplayFormat.Won(g.BuyAmount)</td>
                                    <td class="num">@DisplayFormat.Percent1(g.WeightAfter)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="note">목표보다 비중이 높은 그룹에는 배정하지 않고, 부족한 그룹끼리는 매수 후 목표 비율이 같아지도록 나눕니다.</p>
            </section>

            <section aria-labelledby="h-orders" class="card order-card">
                <h2 id="h-orders" class="card-title table-title">종목별 매수 수량</h2>
                @if (plan.Orders.Count > 0)
                {
                    <div class="table-scroll">
                        <table class="table" style="min-width: 520px">
                            <thead>
                                <tr>
                                    <th scope="col">종목명</th>
                                    <th scope="col">그룹</th>
                                    <th scope="col" class="num">현재가</th>
                                    <th scope="col" class="num">매수 주수</th>
                                    <th scope="col" class="num">매수금액</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in plan.Orders)
                                {
                                    <tr>
                                        <td class="name">@o.Order.SymbolName</td>
                                        <td><span class="group-tag"><span class="dot" style="background: @ColorOf(m, o.GroupName)"></span>@o.GroupName</span></td>
                                        <td class="num">@DisplayFormat.Won(o.Order.Price)</td>
                                        <td class="num buy">@(DisplayFormat.Number(o.Order.Shares))주</td>
                                        <td class="num">@DisplayFormat.Won(o.Order.Amount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="no-orders">@NoOrdersText(plan)</p>
                }
                <p class="note">그룹 배정 금액을 그룹 안 종목의 현재 평가금액 비율로 나눈 뒤, 1주 단위로 내림하고 남는 금액으로 가장 덜 채워진 종목을 1주씩 더 삽니다.</p>
            </section>
        </div>
    }
</main>

@code {
    // 계산 결과는 저장하지 않는다 (설계서 6장). 목업과 같이 처음에는 1,000만 원을 넣어 둔다.
    private decimal _amount = 10_000_000m;
    private RebalancePlan? _plan;

    private string PricedAtText => Model?.State.PricedAt is { } at ? $"{DisplayFormat.Time(at)} 시세 기준이며" : "";

    protected override void OnModelLoaded() => Recalculate();

    private void SetAmount(decimal amount)
    {
        _amount = Math.Clamp(amount, 0m, 100_000_000_000m);
        Recalculate();
    }

    // 입력 즉시, 그리고 시세가 갱신될 때마다 다시 계산한다
    private void Recalculate()
    {
        if (Model is null) return;
        var targets = Model.State.Groups.Select(g => new GroupTarget(g.Id, g.Name, g.TargetWeight)).ToList();
        _plan = RebalancePlanner.Plan(targets, Model.State.Snapshot.Holdings, _amount);
    }

    private static string ColorOf(PortfolioViewModel m, GroupPlan g) => ColorOf(m, g.Name);

    private static string ColorOf(PortfolioViewModel m, string groupName) =>
        m.State.Groups.FirstOrDefault(x => x.Name == groupName)?.Color ?? ChartColors.Unclassified;

    private static IReadOnlyList<ChartSegment> Segments(PortfolioViewModel m, RebalancePlan plan, Func<GroupPlan, decimal> ratio) =>
        plan.Groups.Select(g => new ChartSegment(g.Name, g.Name, ColorOf(m, g), ratio(g))).ToList();

    private static string NoOrdersText(RebalancePlan plan) =>
        plan.NewMoney <= 0 ? "투입 금액을 입력하면 종목별 매수 수량이 표시됩니다."
        : !plan.TargetsValid ? "그룹 목표 비중 합계를 100%로 맞추면 계산됩니다."
        : "투입 금액으로 살 수 있는 종목이 없습니다. 금액이 1주 가격보다 작거나, 배정된 그룹에 시세가 확인된 종목이 없습니다.";
}
