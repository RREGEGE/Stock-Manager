@page "/rebalance"
@inherits LiveComponentBase

<PageTitle>@T[_sellMode ? "리밸런싱 계산" : "추가매수 계산"]</PageTitle>

<main class="page-main">
    <div class="page-head">
        <div>
            @if (_sellMode)
            {
                <h1>@T["리밸런싱 계산"]</h1>
                <p>@T["새 돈을 넣지 않고, 목표보다 많은 그룹을 팔아 부족한 그룹을 삽니다."] @(PricedAtText) @T["수수료·세금은 제외합니다."]</p>
            }
            else
            {
                <h1>@T["추가매수 계산"]</h1>
                <p>@T["매도 없이 매수만으로 목표 비중에 가깝게 배분합니다."] @(PricedAtText) @T["수수료·세금은 제외합니다."]</p>
            }
        </div>
    </div>

    @* 계산 방식 전환: 새 돈으로 사기만 할지, 가진 것 안에서 팔고 살지 (설계서 F-10) *@
    <div class="mode-tabs" role="group" aria-label="@T["계산 방식"]">
        <button type="button" class="mode-tab @(_sellMode ? "" : "active")" aria-pressed="@(_sellMode ? "false" : "true")" @onclick="() => _sellMode = false">@T["추가매수"]</button>
        <button type="button" class="mode-tab @(_sellMode ? "active" : "")" aria-pressed="@(_sellMode ? "true" : "false")" @onclick="() => _sellMode = true">@T["리밸런싱"]</button>
    </div>

    @if (Model is not { } m || _plan is not { } plan || _sellPlan is not { } sell)
    {
        <p class="loading" role="status">@T["불러오는 중…"]</p>
    }
    else if (m.Rows.Count == 0)
    {
        <section class="card empty-state" aria-labelledby="h-start">
            <h2 id="h-start">@T["보유 종목이 있어야 계산할 수 있습니다"]</h2>
            <p>@T["추가매수 배분과 리밸런싱은 지금 보유한 종목과 그룹별 목표 비중을 기준으로 계산합니다."]</p>
            <a href="holdings" class="btn btn-primary">@T["보유 종목 추가하기"]</a>
        </section>
    }
    else
    {
        <PriceNotice State="m.State" />

        @if (!plan.TargetsValid)
        {
            <div class="notice notice-warn" role="alert">
                <span>@T["그룹 목표 비중 합계가 100%가 아니어서 계산할 수 없습니다."]</span>
                <a href="groups">@T["그룹 관리에서 조정하기"]</a>
            </div>
        }
        @if (plan.HasUnclassified)
        {
            <div class="notice notice-warn" role="status">
                <span>@T[_sellMode ? "미분류 종목이 있습니다. 미분류는 목표 0%로 계산되어 전부 매도 대상이 됩니다." : "미분류 종목이 있습니다. 미분류는 목표 0%로 계산되어 매수 배정을 받지 않습니다."]</span>
                <a href="holdings">@T["그룹 지정하기"]</a>
            </div>
        }

        @if (_sellMode)
        {
        <section aria-label="@T["매매 합계"]" class="card sell-summary">
            @if (sell.IsBalanced)
            {
                <p class="balanced" role="status">@T["이미 목표 비중과 같습니다. 옮길 금액이 없습니다."]</p>
            }
            else
            {
                <div class="totals sell-totals">
                    <div>
                        <div class="total-label">@T["매도 합계"]</div>
                        <div class="total-value down" id="sell-total">@T.Won(sell.SellTotal)</div>
                    </div>
                    <div>
                        <div class="total-label">@T["매수 합계"]</div>
                        <div class="total-value up" id="buy-total">@T.Won(sell.BuyTotal)</div>
                    </div>
                    <div>
                        <div class="total-label">@T["남는 금액"]</div>
                        <div class="total-value" id="sell-leftover">@T.Won(sell.Leftover)</div>
                    </div>
                </div>
            }
        </section>

        <section aria-labelledby="h-sell-bars" class="card">
            <div class="bars-head">
                <h2 id="h-sell-bars" class="card-title">@T["그룹 비중 변화"]</h2>
                <div class="bars-legend">
                    @foreach (var g in sell.Groups)
                    {
                        <span class="group-tag"><span class="swatch" style="background: @ColorOf(m, g.Name)"></span>@T.Name(g.Name)</span>
                    }
                </div>
            </div>
            <div class="bars">
                <StackedBar Label="@T["현재"]" Segments="Segments(m, sell, g => g.CurrentWeight)" />
                <StackedBar Label="@T["조정 후"]" Bold="true" Segments="Segments(m, sell, g => g.WeightAfter)" />
                <StackedBar Label="@T["목표"]" Segments="Segments(m, sell, g => g.TargetWeight)" />
            </div>
        </section>

        <div class="split">
            <section aria-labelledby="h-adjust" class="card group-card">
                <h2 id="h-adjust" class="card-title table-title">@T["그룹별 조정 금액"]</h2>
                <div class="table-scroll">
                    <table class="table" style="min-width: 560px">
                        <thead>
                            <tr>
                                <th scope="col">@T["그룹"]</th>
                                <th scope="col" class="num">@T["현재 금액"]</th>
                                <th scope="col" class="num">@T["현재"]</th>
                                <th scope="col" class="num">@T["목표"]</th>
                                <th scope="col" class="num">@T["조정 금액"]</th>
                                <th scope="col" class="num">@T["조정 후"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in sell.Groups)
                            {
                                <tr>
                                    <td>
                                        <span class="group-name"><span class="swatch" style="background: @ColorOf(m, g.Name)"></span>@T.Name(g.Name)</span>
                                        @if (g.CannotTrade && !g.HasHoldings)
                                        {
                                            <span class="badge badge-over" title="@T["이 그룹에 보유 종목이 없어 살 종목을 정할 수 없습니다"]">@T["종목 없음"]</span>
                                        }
                                        else if (g.CannotTrade)
                                        {
                                            <span class="badge badge-stale" title="@T["이 그룹 종목의 현재가가 없어 주수를 계산할 수 없습니다"]">@T["시세 없음"]</span>
                                        }
                                    </td>
                                    <td class="num">@T.Won(g.CurrentValue)</td>
                                    <td class="num">@DisplayFormat.Percent1(g.CurrentWeight)</td>
                                    <td class="num muted">@DisplayFormat.Percent1(g.TargetWeight)</td>
                                    <td class="num buy @(g.Adjustment > 0 ? "up" : g.Adjustment < 0 ? "down" : "")">@AdjustmentText(g.Adjustment)</td>
                                    <td class="num">@DisplayFormat.Percent1(g.WeightAfter)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="note">@T["조정 금액은 '보유 종목 평가금액 합계 × 목표 비중'에서 현재 금액을 뺀 값입니다. 매도 금액의 합과 매수 금액의 합은 같습니다. 예수금은 계산에 넣지 않습니다."]</p>
            </section>

            <section aria-labelledby="h-trades" class="card order-card">
                <h2 id="h-trades" class="card-title table-title">@T["종목별 매도·매수 수량"]</h2>
                @if (sell.Trades.Count > 0)
                {
                    <div class="table-scroll">
                        <table class="table" style="min-width: 560px">
                            <thead>
                                <tr>
                                    <th scope="col">@T["종목명"]</th>
                                    <th scope="col">@T["그룹"]</th>
                                    <th scope="col">@T["구분"]</th>
                                    <th scope="col" class="num">@T["현재가"]</th>
                                    <th scope="col" class="num">@T["주수"]</th>
                                    <th scope="col" class="num">@T["금액"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in sell.Trades)
                                {
                                    <tr>
                                        <td class="name">@t.Order.SymbolName</td>
                                        <td><span class="group-tag"><span class="dot" style="background: @ColorOf(m, t.GroupName)"></span>@T.Name(t.GroupName)</span></td>
                                        <td class="buy @(t.IsSell ? "down" : "up")">@T[t.IsSell ? "매도" : "매수"]</td>
                                        <td class="num">@T.Won(t.Order.Price)</td>
                                        <td class="num buy">@T.Shares(t.Order.Shares)</td>
                                        <td class="num">@T.Won(t.Order.Amount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="no-orders">@NoTradesText(sell)</p>
                }
                <p class="note">@T["매도·매수 금액을 그룹 안 종목의 현재 평가금액 비율로 나눠 1주 단위로 맞춥니다. 그래서 실제 합계는 조정 금액과 조금 다를 수 있고, 판 돈 중 사지 못한 금액이 남습니다. 매도에는 세금과 수수료가 붙을 수 있습니다."]</p>
            </section>
        </div>
        }
        else
        {
        <section aria-label="@T["투입 금액"]" class="card amount-card">
            <div class="field">
                <label for="amount">@T["투입 금액"]</label>
                <div class="amount-input">
                    <MoneyInput Id="amount" Class="amount" Value="_amount" ValueChanged="SetAmount" />
                    <span>@T["원"]</span>
                </div>
            </div>
            <div class="quick">
                <button type="button" class="btn btn-sm" @onclick="() => SetAmount(_amount + 1_000_000m)">@T["+100만"]</button>
                <button type="button" class="btn btn-sm" @onclick="() => SetAmount(_amount + 5_000_000m)">@T["+500만"]</button>
                <button type="button" class="btn btn-sm" @onclick="() => SetAmount(_amount + 10_000_000m)">@T["+1,000만"]</button>
                <button type="button" class="btn btn-ghost" @onclick="() => SetAmount(0m)">@T["지우기"]</button>
            </div>
            <div class="totals">
                <div>
                    <div class="total-label">@T["실제 매수 합계"]</div>
                    <div class="total-value" id="spent">@T.Won(plan.Spent)</div>
                </div>
                <div>
                    <div class="total-label">@T["남는 금액"]</div>
                    <div class="total-value" id="leftover">@T.Won(plan.Leftover)</div>
                </div>
            </div>
        </section>

        <section aria-labelledby="h-bars" class="card">
            <div class="bars-head">
                <h2 id="h-bars" class="card-title">@T["그룹 비중 변화"]</h2>
                <div class="bars-legend">
                    @foreach (var g in plan.Groups)
                    {
                        <span class="group-tag"><span class="swatch" style="background: @ColorOf(m, g)"></span>@T.Name(g.Name)</span>
                    }
                </div>
            </div>
            <div class="bars">
                <StackedBar Label="@T["현재"]" Segments="Segments(m, plan, g => g.CurrentWeight)" />
                <StackedBar Label="@T["매수 후"]" Bold="true" Segments="Segments(m, plan, g => g.WeightAfter)" />
                <StackedBar Label="@T["목표"]" Segments="Segments(m, plan, g => g.TargetWeight)" />
            </div>
        </section>

        <div class="split">
            <section aria-labelledby="h-groups" class="card group-card">
                <h2 id="h-groups" class="card-title table-title">@T["그룹별 매수금액"]</h2>
                <div class="table-scroll">
                    <table class="table" style="min-width: 480px">
                        <thead>
                            <tr>
                                <th scope="col">@T["그룹"]</th>
                                <th scope="col" class="num">@T["현재"]</th>
                                <th scope="col" class="num">@T["목표"]</th>
                                <th scope="col" class="num">@T["매수금액"]</th>
                                <th scope="col" class="num">@T["매수 후"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in plan.Groups)
                            {
                                <tr>
                                    <td>
                                        <span class="group-name"><span class="swatch" style="background: @ColorOf(m, g)"></span>@T.Name(g.Name)</span>
                                        @if (g.HasNoBuyableHoldings && !g.HasHoldings)
                                        {
                                            <span class="badge badge-over" title="@T["이 그룹에 보유 종목이 없어 배정 금액이 남습니다"]">@T["종목 없음"]</span>
                                        }
                                        else if (g.HasNoBuyableHoldings)
                                        {
                                            <span class="badge badge-stale" title="@T["이 그룹 종목의 현재가가 없어 주수를 계산할 수 없습니다"]">@T["시세 없음"]</span>
                                        }
                                    </td>
                                    <td class="num">@DisplayFormat.Percent1(g.CurrentWeight)</td>
                                    <td class="num muted">@DisplayFormat.Percent1(g.TargetWeight)</td>
                                    <td class="num buy">@T.Won(g.BuyAmount)</td>
                                    <td class="num">@DisplayFormat.Percent1(g.WeightAfter)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="note">@T["목표보다 비중이 높은 그룹에는 배정하지 않고, 부족한 그룹끼리는 매수 후 목표 비율이 같아지도록 나눕니다."]</p>
            </section>

            <section aria-labelledby="h-orders" class="card order-card">
                <h2 id="h-orders" class="card-title table-title">@T["종목별 매수 수량"]</h2>
                @if (plan.Orders.Count > 0)
                {
                    <div class="table-scroll">
                        <table class="table" style="min-width: 520px">
                            <thead>
                                <tr>
                                    <th scope="col">@T["종목명"]</th>
                                    <th scope="col">@T["그룹"]</th>
                                    <th scope="col" class="num">@T["현재가"]</th>
                                    <th scope="col" class="num">@T["매수 주수"]</th>
                                    <th scope="col" class="num">@T["매수금액"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in plan.Orders)
                                {
                                    <tr>
                                        <td class="name">@o.Order.SymbolName</td>
                                        <td><span class="group-tag"><span class="dot" style="background: @ColorOf(m, o.GroupName)"></span>@T.Name(o.GroupName)</span></td>
                                        <td class="num">@T.Won(o.Order.Price)</td>
                                        <td class="num buy">@T.Shares(o.Order.Shares)</td>
                                        <td class="num">@T.Won(o.Order.Amount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="no-orders">@NoOrdersText(plan)</p>
                }
                <p class="note">@T["그룹 배정 금액을 그룹 안 종목의 현재 평가금액 비율로 나눈 뒤, 1주 단위로 내림하고 남는 금액으로 가장 덜 채워진 종목을 1주씩 더 삽니다."]</p>
            </section>
        </div>
        }
    }
</main>

@code {
    // 계산 결과는 저장하지 않는다 (설계서 6장). 목업과 같이 처음에는 1,000만 원을 넣어 둔다.
    private decimal _amount = 10_000_000m;
    private RebalancePlan? _plan;
    private SellRebalancePlan? _sellPlan;
    private bool _sellMode;

    private string PricedAtText => Model?.State.PricedAt is { } at ? T.F("{0} 시세 기준이며", DisplayFormat.Time(at)) : "";

    protected override void OnModelLoaded() => Recalculate();

    private void SetAmount(decimal amount)
    {
        _amount = Math.Clamp(amount, 0m, 100_000_000_000m);
        Recalculate();
    }

    // 입력 즉시, 그리고 시세가 갱신될 때마다 다시 계산한다
    private void Recalculate()
    {
        if (Model is null) return;
        var targets = Model.State.Groups.Select(g => new GroupTarget(g.Id, g.Name, g.TargetWeight)).ToList();
        _plan = RebalancePlanner.Plan(targets, Model.State.Snapshot.Holdings, _amount);
        _sellPlan = SellRebalancePlanner.Plan(targets, Model.State.Snapshot.Holdings);
    }

    private static IReadOnlyList<ChartSegment> Segments(PortfolioViewModel m, SellRebalancePlan plan, Func<GroupAdjustment, decimal> ratio) =>
        plan.Groups.Select(g => new ChartSegment(g.Name, g.Name, ColorOf(m, g.Name), ratio(g))).ToList();

    private string AdjustmentText(decimal adjustment) =>
        adjustment > 0 ? T.F("{0} 매수", T.Won(adjustment))
        : adjustment < 0 ? T.F("{0} 매도", T.Won(-adjustment))
        : T["유지"];

    private string NoTradesText(SellRebalancePlan plan) => T[
        !plan.TargetsValid ? "그룹 목표 비중 합계를 100%로 맞추면 계산됩니다."
        : plan.IsBalanced ? "매도하거나 매수할 종목이 없습니다."
        : plan.Groups.Any(g => g.CannotTrade && g.HasHoldings)
            ? "종목의 현재가가 없어 주수를 계산할 수 없습니다. 그룹별 조정 금액까지만 계산했습니다."
        : "조정 금액이 1주 가격보다 작아 매매할 종목이 없습니다."];

    private static string ColorOf(PortfolioViewModel m, GroupPlan g) => ColorOf(m, g.Name);

    private static string ColorOf(PortfolioViewModel m, string groupName) =>
        m.State.Groups.FirstOrDefault(x => x.Name == groupName)?.Color ?? ChartColors.Unclassified;

    private static IReadOnlyList<ChartSegment> Segments(PortfolioViewModel m, RebalancePlan plan, Func<GroupPlan, decimal> ratio) =>
        plan.Groups.Select(g => new ChartSegment(g.Name, g.Name, ColorOf(m, g), ratio(g))).ToList();

    private string NoOrdersText(RebalancePlan plan) => T[
        plan.NewMoney <= 0 ? "투입 금액을 입력하면 종목별 매수 수량이 표시됩니다."
        : !plan.TargetsValid ? "그룹 목표 비중 합계를 100%로 맞추면 계산됩니다."
        : plan.Groups.Any(g => g.HasNoBuyableHoldings && g.HasHoldings)
            ? "배정된 그룹 종목의 현재가가 없어 매수 주수를 계산할 수 없습니다. 그룹별 배정 금액까지만 계산했습니다."
        : "투입 금액으로 살 수 있는 종목이 없습니다. 금액이 1주 가격보다 작거나, 배정된 그룹에 보유 종목이 없습니다."];
}
