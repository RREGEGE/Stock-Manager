@page "/signup"
@layout LoginLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.Extensions.Options
@using Portfolio.Web.Auth
@inject AccountService Accounts
@inject IOptions<AuthOptions> Auth
@inject NavigationManager Navigation

<PageTitle>가입</PageTitle>

@* 계정은 1개뿐이다. 계정이 아직 없을 때만 이 화면이 열리고, 가입하면 닫힌다 (설계서 7.3). *@
<main class="auth-page">
    <section class="card auth-card" aria-labelledby="h-signup">
        <h1 id="h-signup" class="auth-title">포트폴리오</h1>
        <p class="auth-sub">처음 사용합니다. 로그인에 쓸 계정을 만드세요.</p>

        <form method="post" @formname="signup" @onsubmit="SubmitAsync" class="auth-form">
            <AntiforgeryToken />
            <div class="field">
                <label for="username">아이디</label>
                <input id="username" name="UserName" type="text" class="input" value="@UserName"
                       autocomplete="username" autocapitalize="none" spellcheck="false"
                       minlength="@AuthOptions.MinUserNameLength" maxlength="@AuthOptions.MaxUserNameLength" autofocus required />
            </div>
            <div class="field">
                <label for="password">비밀번호 (@(AuthOptions.MinPasswordLength)자 이상)</label>
                <input id="password" name="Password" type="password" class="input" autocomplete="new-password"
                       minlength="@AuthOptions.MinPasswordLength" required />
            </div>
            <div class="field">
                <label for="confirm">비밀번호 확인</label>
                <input id="confirm" name="ConfirmPassword" type="password" class="input" autocomplete="new-password" required />
            </div>
            @if (_message is not null)
            {
                <p class="field-error" role="alert">@_message</p>
            }
            <button type="submit" class="btn btn-primary auth-button">가입하고 시작하기</button>
        </form>
        <p class="note">계정은 하나만 만들 수 있습니다. 가입한 뒤에는 다른 PC와 휴대폰에서도 같은 아이디로 로그인합니다.</p>
    </section>
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "signup")] private string? UserName { get; set; }
    [SupplyParameterFromForm(FormName = "signup")] private string? Password { get; set; }
    [SupplyParameterFromForm(FormName = "signup")] private string? ConfirmPassword { get; set; }

    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.Value.Enabled)
        {
            Navigation.NavigateTo("/");
            return;
        }
        // 이미 계정이 있으면 가입 화면은 닫혀 있다
        if (await Accounts.IsRegisteredAsync())
            Navigation.NavigateTo("/login");
    }

    private async Task SubmitAsync()
    {
        if (await Accounts.IsRegisteredAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (Password != ConfirmPassword)
        {
            _message = "비밀번호와 비밀번호 확인이 서로 다릅니다.";
            return;
        }

        try
        {
            await Accounts.RegisterAsync(UserName, Password);
        }
        catch (ArgumentException ex)
        {
            _message = ex.Message;
            return;
        }
        catch (InvalidOperationException)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // 가입과 동시에 이 기기는 로그인된다
        await AccountSignIn.SignInAsync(HttpContext, Accounts);
        Navigation.NavigateTo("/");
    }
}
