@page "/login"
@layout LoginLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.Extensions.Options
@using Portfolio.Web.Auth
@inject AccountService Accounts
@inject LoginThrottle Throttle
@inject IOptions<AuthOptions> Auth
@inject NavigationManager Navigation

<PageTitle>@T["로그인"]</PageTitle>

@* 쿠키를 발급해야 하므로 이 화면은 서버 렌더링(폼 전송)으로 동작한다 *@
<main class="auth-page">
    <section class="card auth-card" aria-labelledby="h-login">
        <h1 id="h-login" class="auth-title">@T["포트폴리오"]</h1>
        <p class="auth-sub">@T["로그인"]</p>

        <form method="post" @formname="login" @onsubmit="SubmitAsync" class="auth-form">
            <AntiforgeryToken />
            <div class="field">
                <label for="username">@T["아이디"]</label>
                <input id="username" name="UserName" type="text" class="input" value="@UserName"
                       autocomplete="username" autocapitalize="none" spellcheck="false" autofocus required />
            </div>
            <div class="field">
                <label for="password">@T["비밀번호"]</label>
                <input id="password" name="Password" type="password" class="input" autocomplete="current-password" required />
            </div>
            @if (_message is not null)
            {
                <p class="field-error" role="alert">@T[_message]</p>
            }
            <button type="submit" class="btn btn-primary auth-button">@T["로그인"]</button>
        </form>
        <p class="note">@T["한 번 로그인하면 이 기기에서 90일 동안 유지됩니다."]</p>
    </section>
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "login")] private string? UserName { get; set; }
    [SupplyParameterFromForm(FormName = "login")] private string? Password { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        // 로그인이 꺼져 있거나(개발용 가짜 시세) 이미 로그인했으면 바로 들어간다
        if (!Auth.Value.Enabled || HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(AccountSignIn.SafeReturnUrl(ReturnUrl));
            return;
        }
        // 계정이 아직 없으면 가입 화면으로 보낸다
        if (!await Accounts.IsRegisteredAsync())
        {
            Navigation.NavigateTo("/signup");
            return;
        }
        if (Throttle.LockRemaining is { } remaining)
            _message = LoginThrottle.Message(remaining, T);
    }

    private async Task SubmitAsync()
    {
        if (Throttle.LockRemaining is { } remaining)
        {
            _message = LoginThrottle.Message(remaining, T);
            return;
        }

        if (!await Accounts.VerifyAsync(UserName, Password))
        {
            Throttle.RecordFailure();
            _message = Throttle.LockRemaining is { } locked
                ? LoginThrottle.Message(locked, T)
                : "아이디 또는 비밀번호가 맞지 않습니다.";
            return;
        }

        Throttle.RecordSuccess();
        await AccountSignIn.SignInAsync(HttpContext, Accounts);
        Navigation.NavigateTo(AccountSignIn.SafeReturnUrl(ReturnUrl));
    }
}
