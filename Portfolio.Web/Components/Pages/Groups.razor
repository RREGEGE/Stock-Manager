@page "/groups"
@inherits LiveComponentBase

<PageTitle>@T["그룹 관리"]</PageTitle>

<main class="page-main">
    <div class="page-head">
        <div>
            <h1>@T["그룹 관리"]</h1>
            <p>@T["그룹별 목표 비중을 정합니다. 합계가 100%여야 저장되고, 추가매수 계산에 바로 반영됩니다."]</p>
        </div>
    </div>

    @if (Model is not { } m)
    {
        <p class="loading" role="status">@T["불러오는 중…"]</p>
    }
    else
    {
        var unclassified = m.Rows.Where(r => r.GroupId is null).ToList();

        <div class="split">
            <GroupTargetTable Model="m" />

            <div class="side stack">
                <section aria-labelledby="h-unc" class="card">
                    <h2 id="h-unc" class="card-title side-title">@T["미분류 종목"]</h2>
                    @if (unclassified.Count == 0)
                    {
                        <p class="side-text">@T["모든 종목에 그룹이 지정되어 있습니다."]</p>
                    }
                    else
                    {
                        <ul class="unclassified">
                            @foreach (var r in unclassified)
                            {
                                <li><span>@r.View.SymbolName</span><span class="muted">@T.Won(r.View.EstimatedAmount)</span></li>
                            }
                        </ul>
                        <p class="side-text">@((MarkupString)T["<a href=\"holdings\">보유 종목</a>에서 그룹을 지정하세요."])</p>
                    }
                </section>
                <section aria-labelledby="h-help" class="card">
                    <h2 id="h-help" class="card-title help-title">@T["그룹 삭제 시"]</h2>
                    <p class="side-text help-text">@T["소속 종목은 미분류로 옮겨지고, 목표 비중은 다른 그룹에 다시 나눠 입력해야 합니다."]</p>
                </section>
            </div>
        </div>
    }
</main>
