<!DOCTYPE html>
<html lang="@T.Language">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Portfolio.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="icon-192.png" />
    @* 휴대폰 홈 화면에 추가하면 주소창 없이 앱처럼 열린다 *@
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#1B1F24" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@T["포트폴리오"]" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" AccountId="CurrentAccount.ReadCookie(HttpContext)" Language="@T.Language" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // 화면 전체를 Interactive Server로 그린다 (설계서 3장). 데이터를 두 번 읽지 않도록 사전 렌더링은 끈다.
    // 로그인 화면처럼 [ExcludeFromInteractiveRouting]이 붙은 화면만 서버 렌더링으로 둔다.
    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);

    // 이 브라우저가 고른 언어 (쿠키). 화면 연결에는 Routes가 다시 넘겨준다 (F-12).
    protected override void OnInitialized() => T.Language = Loc.ReadCookie(HttpContext);

    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? Interactive : null;
}
